    "pi-commit-fast": {
      "name": "Lightweight commit (Pi)",
      "description": "Run lightweight commit with Pi",
      "cmd": "python3 \"$HOME/.config/nvim/scripts/pi-trace.py\" --model \"opencode-go/minimax-m3\" \"/skill:lightweight-commit Please create a lightweight commit for the currently staged changes\""
