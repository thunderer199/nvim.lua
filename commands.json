{
  "commands": {
    "ai-commit-fast": {
      "name": "Lightweight commit (OpenCode)",
      "description": "Run lightweight commit with OpenCode",
      "cmd": "opencode run \"/lightweight-commit\" \"Please create a lightweight commit for the currently staged changes\" -m \"opencode-go/minimax-m3\" --agent build && opencode export $(opencode session list --max-count 1 --format json | jq -r '.[].id') | jq -r '.info as $i | .messages[-1].info as $m | \"\\($m.modelID) • \\($m.providerID) • \\((($i.time.updated-$i.time.created)/1000)|floor)s • \\($m.tokens.total) tokens (\\($m.tokens.input)i+\\($m.tokens.output)o+\\($m.tokens.reasoning)r, cache \\($m.tokens.cache.read)r/\\($m.tokens.cache.write)w) • $\\( $m.cost )\"'"
    },
    "ai-commit": {
      "name": "Lightweight commit (OpenCode, choose model)",
      "description": "Run lightweight commit with OpenCode and pick model via placeholder",
      "cmd": "opencode run \"/lightweight-commit\" \"Please create a lightweight commit for the currently staged changes\" -m $(echo ${model} | cut -d: -f1) $(echo ${model} | grep -q ':' && echo --variant $(echo ${model} | cut -d: -f2)) --agent build && opencode export $(opencode session list --max-count 1 --format json | jq -r '.[].id') | jq -r '.info as $i | .messages[-1].info as $m | \"\\($m.modelID) • \\($m.providerID) • \\((($i.time.updated-$i.time.created)/1000)|floor)s • \\($m.tokens.total) tokens (\\($m.tokens.input)i+\\($m.tokens.output)o+\\($m.tokens.reasoning)r, cache \\($m.tokens.cache.read)r/\\($m.tokens.cache.write)w) • $\\( $m.cost )\"'",
